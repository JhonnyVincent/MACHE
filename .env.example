# ---------------------------------------------------------------------------
# Supabase (obligatoire)
# Tableau de bord Supabase > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Les projets Supabase récents nomment la clé publique "publishable key".
# Cette variable est acceptée en remplacement de NEXT_PUBLIC_SUPABASE_ANON_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---------------------------------------------------------------------------
# URL publique du site (obligatoire)
# Utilisée pour les liens des e-mails Supabase (inscription, mot de passe
# oublié). Sans elle, le lien de réinitialisation pointe vers
# "undefined/auth/callback" et l'utilisateur ne peut pas changer son mot
# de passe. Pas de "/" final.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Assistant IA (optionnel)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-xxx
