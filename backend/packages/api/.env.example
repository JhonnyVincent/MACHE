# Adresse publique du site. Les origines autorisées (STORE_CORS,
# ADMIN_CORS, VENDOR_CORS, AUTH_CORS) et l'adresse d'invalidation du
# cache s'en déduisent : il n'y a qu'elle à renseigner.
STOREFRONT_URL=http://localhost:3000

# Facultatives : uniquement pour ajouter une origine (domaine propre,
# préproduction). Laissées vides, elles sont déduites de STOREFRONT_URL
# et de l'adresse du serveur lui-même.
# STORE_CORS=
# ADMIN_CORS=
# VENDOR_CORS=
# AUTH_CORS=
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-openssl-rand-hex-32
COOKIE_SECRET=change-me-openssl-rand-hex-32
DATABASE_URL=postgres://user:password@host:5432/mache_commerce
MERCUR_VENDOR_URL=http://localhost:7001

# Partagé avec le site : il autorise ce serveur à vider le cache du site
# quand un prix ou un produit change. La même valeur doit être posée
# côté site, dans STOREFRONT_REVALIDATE_SECRET.
STOREFRONT_REVALIDATE_SECRET=change-me-openssl-rand-hex-32

# Facultative : uniquement si le site est servi depuis un sous-chemin.
# Une adresse sans chemin est complétée par /api/revalidate.
# STOREFRONT_REVALIDATE_URL=
